# Optional. Without the CRM, every lead is POSTed as JSON to this URL (Make, Zapier, n8n, Slack…).
# With the CRM configured it is a backup: only leads the CRM does not have (no duplicates).
# Anything that is not an http(s) URL (e.g. "off") disables it.
LEAD_WEBHOOK_URL=

# LIKIN CRM (Lead Ingestion). Server-side only: never NEXT_PUBLIC_, never in git, never in logs.
# Generated from the CRM repo with `npm run ingest:web-key -- write likinagency.com <path to this .env.local>`.
# All three empty → no CRM: the e-mail (and the webhook, if set) keeps every lead.
CRM_INGEST_URL=
CRM_INGEST_KEY_ID=
CRM_INGEST_SECRET=
# Only while the CRM is a protected Vercel preview: its Protection Bypass for Automation secret,
# sent as a header from the server. Never in production, never NEXT_PUBLIC_.
CRM_INGEST_BYPASS_SECRET=

# Lead e-mail (Resend). Server-side only. Without the CRM, EVERY lead is e-mailed (the e-mail is
# the record, with the lead-<id>.json attachment); with the CRM, only when the CRM did not confirm,
# unless LEAD_EMAIL_ALWAYS=1 (one e-mail per lead, saying whether the CRM registered it).
# BOTH RESEND_API_KEY and LEAD_EMAIL_FROM are required (either one alone sends nothing).
# LEAD_EMAIL_FROM must be a sender of a domain verified in Resend, e.g. "LIKIN Web <web@likinagency.com>";
# LEAD_EMAIL_TO defaults to taras@likinagency.com.
RESEND_API_KEY=
LEAD_EMAIL_FROM=
LEAD_EMAIL_TO=
LEAD_EMAIL_ALWAYS=

# Qualification form integrations. Public URLs only — never a secret key.
# Leave empty and the result screens fall back to email; they never show a fabricated link.
NEXT_PUBLIC_STRIPE_BUILD_CHECKOUT_URL=
NEXT_PUBLIC_CALENDLY_BUILD_URL=
NEXT_PUBLIC_CALENDLY_SCALE_URL=

# Meta: id del píxel (público, va al navegador). Vacío: ni píxel ni aviso de cookies.
NEXT_PUBLIC_META_PIXEL_ID=
# Meta: token de la API de Conversiones (SECRETO: solo servidor; nunca NEXT_PUBLIC_, nunca en git) y
# código de prueba opcional (solo para «Probar eventos»: con él Meta no usa los eventos del servidor).
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
